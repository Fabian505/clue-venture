# secrets.properties.template
#
# Copy this file to secrets.properties and fill in your real values.
# secrets.properties is listed in .gitignore and must NEVER be committed.
#
# How to obtain these values:
#   1. Create a project at https://supabase.com
#   2. Go to Project Settings → API
#   3. Copy "Project URL" → SUPABASE_URL
#   4. Copy "anon / public" key → SUPABASE_ANON_KEY

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
